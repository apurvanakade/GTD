#!/bin/sh
# Refuse to commit while the test suite fails. Enabled with: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" && uv run pytest -q -x || {
  echo "pre-commit: tests fail, commit refused (git commit --no-verify to override)." >&2
  exit 1
}
# Browser tests are slow: only when the commit touches templates or static files (where the JS lives).
git diff --cached --name-only | grep -qE '^(templates|static)/' && { uv run pytest -q -x -m browser || {
  echo "pre-commit: browser tests fail, commit refused (git commit --no-verify to override)." >&2
  exit 1
}; }
exit 0
