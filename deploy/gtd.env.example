# /etc/apps/gtd.env on the `home` VM (see ~/Github/personal/GCP-home-server), read by app@gtd.service.
# systemd doesn't strip trailing comments, so keep comments on their own lines.
PORT=5005
GTD_DB=/var/lib/apps/gtd/gtd.db
# Generate with: python3 -c 'import secrets;print(secrets.token_hex(32))'
GTD_SECRET=change-me
TZ=America/New_York
CMD=uv run --frozen --no-dev gunicorn -w 1 --threads 4 -b 127.0.0.1:5005 app:app
# The app's own address, so a reminder opens its task
GTD_URL=https://home.<tailnet>.ts.net
# The ntfy topic reminders go to (ntfy-setup.sh in GCP-home-server); unset sends none
NTFY_URL=http://127.0.0.1:5007/gtd
